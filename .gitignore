# ========================================
# BLOOMCARE - Root .gitignore
# Covers: Backend (Node.js/TypeScript) + Frontend (React/Vite)
# ========================================

# ========================================
# NODE DEPENDENCIES
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ========================================
# BUILD OUTPUTS
# ========================================
# Backend builds
dist/
build/
out/
*.tsbuildinfo

# Frontend builds
bloomcare-frontend/dist/
bloomcare-frontend/build/

# ========================================
# ENVIRONMENT VARIABLES
# ========================================
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test

# ========================================
# DEPLOYMENT & CONFIGURATION
# ========================================
.DS_Store
*.log
*.pid
*.seed
*.pid.lock

# ========================================
# IDE & EDITOR FILES
# ========================================
# VS Code
.vscode/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.vimrc

# ========================================
# OS FILES
# ========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ========================================
# TESTING COVERAGE
# ========================================
coverage/
.nyc_output/
.jest/
test-results/

# ========================================
# CACHE & TEMPORARY FILES
# ========================================
.cache/
.temp/
tmp/
temp/
*.tmp
*.temp

# ========================================
# BACKEND SPECIFIC
# ========================================
# Logs
logs/
*.log

# MongoDB data
data/
mongodb-data/

# Uploads
uploads/
uploads/*

# Backend build
bloomcare-backend/dist/
bloomcare-backend/build/

# ========================================
# FRONTEND SPECIFIC
# ========================================
# Vite
bloomcare-frontend/dist/
bloomcare-frontend/.vite/

# React
bloomcare-frontend/build/
bloomcare-frontend/*.tsbuildinfo

# ========================================
# SECURITY FILES
# ========================================
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials/

# ========================================
# DATABASE & MIGRATIONS
# ========================================
*.sqlite
*.db
*.mdb
*.accdb
migrations/*.sql

# ========================================
# DOCKER & KUBERNETES
# ========================================
# Docker
*.dockerignore
Dockerfile.local

# Kubernetes
*.kubeconfig
kubeconfig
*.k8s.local

# ========================================
# CI/CD
# ========================================
# GitHub Actions
.github/workflows/*.local.yml

# GitLab CI
.gitlab-ci.local.yml

# ========================================
# AWS & CLOUD SERVICES
# ========================================
.aws/
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.truststore

# ========================================
# APPLICATION SPECIFIC
# ========================================
# Stripe
stripe.log
webhook.log

# Cloudinary
cloudinary_*.log

# Email
email_*.log

# AI
ai_*.log

# ========================================
# BACKUP FILES
# ========================================
*.bak
*.backup
*.old
*.orig
*.rej

# ========================================
# ARCHIVE FILES
# ========================================
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# ========================================
# MISC
# ========================================
# ESLint
.eslintcache

# Prettier
.prettiercache

# TypeScript
*.tsbuildinfo

# Jest
jest.config.js.local

# Yarn
.yarn/
.yarnrc
.yarnrc.yml

# PNPM
.pnpm-store/

# NX
.nx/
nx.json.local

# ========================================
# DOCS & GENERATED FILES
# ========================================
docs/_build/
docs/api/
*.md~
README.md.bak

# ========================================
# PERSONAL FILES
# ========================================
*.personal.*
*.private.*
notes.md
TODO.md
draft.*

# ========================================
# PROJECT SPECIFIC IGNORES
# ========================================
# Ignore seed data backups
seed-backup/
*.seed-backup.json

# Ignore temporary test files
test-temp/
*.test-tmp.ts
*.test-tmp.js

# Ignore local development certificates
certs/
*.cert
*.csr

# ========================================
# EXCLUDE SENSITIVE FILES
# ========================================
# Phone numbers, emails, etc.
*.contacts.json
*.emails.json

# ========================================
# EXCLUDE LARGE FILES
# ========================================
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.flac
*.psd
*.ai
*.eps
*.tiff
*.bmp
*.ico
*.webp

# ========================================
# EXCLUDE DEPENDENCY REPORTS
# ========================================
dependency-report.html
security-report.html
audit-report.html